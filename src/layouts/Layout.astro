---
import BaseHead from '../components/BaseHead.astro';
interface Props { title: string; description: string; image?: string }
const { title, description, image } = Astro.props;
const path = Astro.url.pathname;
const isActive = (base: string) => path === base || (base !== '/' && path.startsWith(base));
---

<html lang="en">
<head><BaseHead {title} {description} {image} /></head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="header-logo"><img src="/logo.svg" alt="SoftStack" style="height:22px;width:auto" /></a>
      <nav class="header-nav">
        <a href="/software/" class={isActive('/software') ? 'active' : ''}>All Apps</a>
        <a href="/categories/" class={isActive('/categories') ? 'active' : ''}>Categories</a>
        <a href="/articles/" class={isActive('/articles') ? 'active' : ''}>Articles</a>
        <a href="/about/" class={isActive('/about') ? 'active' : ''}>About</a>
      </nav>
      <div class="header-search" id="header-search">
        <button class="search-trigger" id="search-trigger" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span class="search-hint">Search apps...</span>
          <span class="search-kbd-hint">⌘K</span>
        </button>
      </div>
    </div>
  </header>

  <div class="search-overlay" id="search-overlay">
    <div class="search-modal">
      <div class="search-input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" class="search-input" id="search-input" placeholder="Search apps..." autofocus />
        <kbd class="search-kbd">esc</kbd>
      </div>
      <div class="search-results" id="search-results"></div>
      <div class="search-empty" id="search-empty">Type to search apps</div>
    </div>
  </div>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">🧩 SoftStack</a>
        <p>Handpicked free, legit, and genuinely useful GUI apps. Every tool tested and vouched for.</p>
      </div>
      <div class="footer-links-group">
        <div class="footer-col">
          <h4>Product</h4>
          <a href="/software/">All Apps</a>
          <a href="/categories/">Categories</a>
          <a href="/articles/">Articles</a>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <a href="/about/">About</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
        </div>
        <div class="footer-col">
          <h4>Support</h4>
          <a href="mailto:support@softstack.cc">Help & Feedback</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} SoftStack. All rights reserved.</span>
    </div>
  </footer>

  <script>
    let apps = [];
    const overlay = document.getElementById('search-overlay')!;
    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('search-results')!;
    const empty = document.getElementById('search-empty')!;
    const trigger = document.getElementById('search-trigger')!;

    fetch('/search-index').then(r => r.json()).then(data => {
      apps = data;
      empty.textContent = `Type to search ${apps.length} apps`;
    });

    trigger.addEventListener('click', () => { overlay.classList.add('open'); setTimeout(() => input.focus(), 100); });
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeSearch(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSearch();
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); overlay.classList.add('open'); setTimeout(() => input.focus(), 100); }
    });

    function closeSearch() { overlay.classList.remove('open'); input.value = ''; results.innerHTML = ''; empty.style.display = ''; }

    const catNames = { productivity:'Productivity', developer:'Dev Tools', design:'Design', writing:'Writing', utility:'Utilities', media:'Media', communication:'Communication', security:'Security' };
    const priceNames = { free:'Free', freemium:'Freemium', 'open-source':'Open Source', trial:'Trial' };

    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      if (!q) { results.innerHTML = ''; empty.style.display = ''; return; }
      const matched = apps.filter(a =>
        a.name.toLowerCase().includes(q) ||
        a.tagline.toLowerCase().includes(q) ||
        a.category.toLowerCase().includes(q)
      ).slice(0, 8);

      if (!matched.length) { results.innerHTML = '<div class="search-no-results">No results</div>'; empty.style.display = 'none'; return; }
      empty.style.display = 'none';
      results.innerHTML = matched.map(a => `
        <a href="/software/${a.slug}/" class="search-result">
          <span class="search-result-icon">${a.name.charAt(0)}</span>
          <div class="search-result-body">
            <div class="search-result-name">${a.name}</div>
            <div class="search-result-tagline">${a.tagline}</div>
            <div class="search-result-meta">
              <span class="badge badge-category">${catNames[a.category] || a.category}</span>
              <span class="badge badge-price">${priceNames[a.price] || a.price}</span>
            </div>
          </div>
        </a>
      `).join('');
    });
  </script>
</body>
</html>