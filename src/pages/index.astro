---
import Layout from '../layouts/Layout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const categoryNames: Record<string, string> = {
  productivity:'Productivity', developer:'Developer Tools', design:'Design', writing:'Writing',
  utility:'Utilities', media:'Media', communication:'Communication', security:'Security', other:'Other'
};

const categoryIcons: Record<string, string> = {
  productivity:'fa-solid fa-bolt', developer:'fa-solid fa-code', design:'fa-solid fa-palette', writing:'fa-solid fa-pen',
  utility:'fa-solid fa-toolbox', media:'fa-solid fa-play', communication:'fa-solid fa-comment', security:'fa-solid fa-shield', other:'fa-solid fa-ellipsis'
};

const all = (await getCollection('software')).filter(p => !p.data.draft && p.data.type === 'gui');
const featured = all.filter(p => p.data.featured);
const categories = [...new Set(all.map(p => p.data.category))].sort();
const countByCat = (cat: string) => all.filter(p => p.data.category === cat).length;
---

<Layout title="SoftStack — Curated, Shared with Love" description="Handpicked free, legit, and genuinely useful GUI apps. Every tool has been tested and vouched for.">
  <div class="main-layout">
    <Sidebar activeAll={true} />

    <div class="content-area">
      <section class="hero">
        <h1>Find the right tool<br/>for the job</h1>
        <p>Handpicked free, legit, and genuinely useful GUI apps. Every pick tested and vouched for.</p>
      </section>

      {featured.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2><i class="fa-solid fa-star" style="color:var(--yellow);font-size:.85em;margin-right:8px"></i>Featured</h2>
          </div>
          <div class="carousel-wrap">
            <button class="carousel-btn prev" id="feat-prev" aria-label="Scroll left"><i class="fa-solid fa-chevron-left"></i></button>
            <div class="carousel" id="feat-carousel">
              {featured.map(p => <SoftwareCard entry={p} />)}
            </div>
            <button class="carousel-btn next" id="feat-next" aria-label="Scroll right"><i class="fa-solid fa-chevron-right"></i></button>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-header">
          <h2>Browse by Category</h2>
        </div>
        <div class="pill-group">
          {categories.map(c => (
            <a href={`/categories/${c}/`} class="pill">
              <i class={categoryIcons[c]}></i>
              {categoryNames[c]}
              <span class="count">{countByCat(c)}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>All Software</h2>
          <a href="/software/">View all ({all.length}) →</a>
        </div>
        <div class="card-grid">
          {all.slice(0, 12).map(p => <SoftwareCard entry={p} />)}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  const track = document.getElementById('feat-carousel');
  const prev = document.getElementById('feat-prev');
  const next = document.getElementById('feat-next');
  if (track && prev && next) {
    const scrollBy = () => Math.min(track.clientWidth * 0.8, 600);
    prev.addEventListener('click', () => track.scrollBy({ left: -scrollBy(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: scrollBy(), behavior: 'smooth' }));
  }
</script>