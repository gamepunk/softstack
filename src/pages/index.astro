---
import Layout from '../layouts/Layout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import { getCollection } from 'astro:content';

const categoryNames: Record<string, string> = {
  productivity:'Productivity', developer:'Dev Tools', design:'Design', writing:'Writing',
  utility:'Utilities', media:'Media', communication:'Communication', security:'Security', other:'Other'
};

const all = (await getCollection('software')).filter(p => !p.data.draft && p.data.type === 'gui');
const featured = all.filter(p => p.data.featured);
const categories = [...new Set(all.map(p => p.data.category))].sort();
const countByCat = (cat: string) => all.filter(p => p.data.category === cat).length;
---

<Layout title="SoftStack — Curated, Shared with Love" description="Handpicked free, legit, and genuinely useful GUI apps. Every tool has been tested and vouched for.">
  <section class="hero">
    <h1>Curated with care,<br/>shared with love.</h1>
    <p>Only free, legit, and genuinely useful GUI apps. Every pick has been tested and vouched for — no pay-to-play, no filler.</p>
  </section>

  <section class="section">
    <h2>Browse by Category</h2>
    <div class="pill-group">
      {categories.map(c => (
        <a href={`/categories/${c}/`} class="pill">
          {categoryNames[c] ?? c}
          <span class="count">{countByCat(c)}</span>
        </a>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>Featured</h2>
      </div>
      <div class="card-grid">
        {featured.map(p => <SoftwareCard entry={p} />)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-header">
      <h2>All Software</h2>
      <a href="/software/">View all ({all.length}) →</a>
    </div>
    <div class="card-grid">
      {all.slice(0, 12).map(p => <SoftwareCard entry={p} />)}
    </div>
  </section>
</Layout>
