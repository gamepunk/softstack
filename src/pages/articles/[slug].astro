---
import Layout from '../../layouts/Layout.astro';
import SoftwareCard from '../../components/SoftwareCard.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map(e => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const article = allArticles.find(a => a.id === slug);
if (!article) return Astro.redirect('/404');

const { data } = article;
const rendered = await render(article);

const appRegex = /<!-- app:([a-zA-Z0-9_-]+) -->/g;
const cardSlugs: string[] = [];
let m;
const rawBody = article.body || '';
while ((m = appRegex.exec(rawBody)) !== null) cardSlugs.push(m[1]);

const cardEntries = new Map();
for (const s of cardSlugs) {
  const e = await getEntry('software', s);
  if (e) cardEntries.set(s, e);
}

const categoryLabels = { tutorial: 'Tutorial', roundup: 'Roundup', guide: 'Guide' };
const title = `${data.title} — SoftStack`;
---

<Layout {title} description={data.description}>
  <div class="page-container">
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/articles/">Articles</a> <span>/</span>
    {data.title}
  </nav>

  <article style="max-width:var(--content);margin:0 auto">
    <div style="margin-bottom:var(--gap-sm);font-size:.75rem;color:var(--text-tertiary);display:flex;gap:var(--gap-sm);align-items:center">
      <span class="badge badge-category">{categoryLabels[data.category]}</span>
      <time>{data.date.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })}</time>
    </div>

    <h1 style="font-size:2rem;margin-bottom:var(--gap-sm)">{data.title}</h1>

    {data.tags.length > 0 && (
      <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:var(--gap-lg)">
        {data.tags.map(t => <span style="font-size:.68rem;padding:2px 8px;border-radius:99px;background:var(--border);color:var(--text-secondary)">{t}</span>)}
      </div>
    )}

    <div class="article-body">
      <rendered.Content />
    </div>

    {cardSlugs.length > 0 && cardEntries.size > 0 && (
      <div style="margin-top:var(--gap-xl);padding-top:var(--gap-lg);border-top:1px solid var(--border)">
        <h2 style="margin-bottom:var(--gap)">Apps Mentioned</h2>
        <div class="card-grid">
          {cardSlugs.map(s => cardEntries.has(s) && <SoftwareCard entry={cardEntries.get(s)!} />)}
        </div>
      </div>
    )}
  </article>
  </div>
</Layout>

<style>
  .article-body{font-size:1.02rem;line-height:1.85;color:var(--text-secondary)}
  .article-body :global(h2){font-size:1.3rem;color:var(--text);margin:var(--gap-xl) 0 var(--gap-sm);padding-top:var(--gap)}
  .article-body :global(h3){font-size:1.1rem;color:var(--text);margin:var(--gap-lg) 0 var(--gap-sm)}
  .article-body :global(p){margin-bottom:var(--gap)}
  .article-body :global(ul),.article-body :global(ol){margin:var(--gap) 0;padding-left:1.5rem}
  .article-body :global(li){margin-bottom:.4rem}
  .article-body :global(code){font-size:.85em;background:var(--border);padding:2px 6px;border-radius:4px;font-family:"SF Mono",SFMono-Regular,Menlo,Monaco,monospace}
  .article-body :global(pre){background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:var(--gap);overflow-x:auto;margin:var(--gap) 0;font-size:.85rem;line-height:1.6}
  .article-body :global(pre code){background:none;padding:0}
  .article-body :global(table){width:100%;border-collapse:collapse;margin:var(--gap) 0}
  .article-body :global(th),.article-body :global(td){text-align:left;padding:var(--gap-sm) var(--gap);border-bottom:1px solid var(--border)}
  .article-body :global(th){font-weight:600;color:var(--text);font-size:.8rem;text-transform:uppercase;letter-spacing:.05em}
  .article-body :global(blockquote){border-left:3px solid var(--accent);padding-left:var(--gap);color:var(--text-secondary);margin:var(--gap) 0;font-style:italic}
  .article-body :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:2px}
</style>
