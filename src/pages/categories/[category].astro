---
import Layout from '../../layouts/Layout.astro';
import SoftwareCard from '../../components/SoftwareCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('software', ({ data }) => !data.draft && data.type === 'gui');
  const cats = [...new Set(entries.map(e => e.data.category))];
  return cats.map(c => ({ params: { category: c } }));
}

const categoryNames: Record<string, string> = {
  productivity:'Productivity', developer:'Dev Tools', design:'Design', writing:'Writing',
  utility:'Utilities', media:'Media', communication:'Communication', security:'Security', other:'Other'
};

const { category } = Astro.params;
const all = await getCollection('software', ({ data }) => !data.draft && data.type === 'gui' && data.category === category);

if (!all.length) return Astro.redirect('/404');

const label = categoryNames[category!] ?? category;
const title = `${label} — SoftStack`;
---

<Layout {title} description={`Handpicked ${(label as string).toLowerCase()} tools — free, legit, and genuinely useful.`}>
  <div class="main-layout">
    <Sidebar activeCategory={category} />
    <div class="content-area">
      <nav class="breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/categories/">Categories</a> <span>/</span>
        {label}
      </nav>

      <h1 style="margin-bottom:var(--gap-sm)">{label}</h1>
      <p style="margin-bottom:var(--gap)"><span id="filter-count">{all.length}</span> handpicked apps</p>

      <FilterBar />

      <div class="card-grid">
        {all.map(e => <SoftwareCard entry={e} />)}
      </div>
    </div>
  </div>
</Layout>
