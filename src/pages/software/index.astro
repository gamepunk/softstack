---
import Layout from '../../layouts/Layout.astro';
import SoftwareCard from '../../components/SoftwareCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('software', ({ data }) => !data.draft && data.type === 'gui');
const perPage = 48;
---

<Layout title="All Software — SoftStack" description="Browse every free, legit, and genuinely useful GUI app on SoftStack.">
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    All Software
  </nav>

  <h1 style="margin-bottom:var(--gap-sm)">All Software</h1>
  <p style="margin-bottom:var(--gap)" id="page-info"><span id="filter-count">{all.length}</span> handpicked apps. Free, legit, and genuinely useful.</p>

  <FilterBar />

  <div class="card-grid" id="app-grid">
    {all.slice(0, perPage).map(e => <SoftwareCard entry={e} />)}
  </div>

  <nav class="pagination" id="pagination"></nav>
</Layout>

<script>
  const PER_PAGE = 48;
  let allApps = [];
  let filteredApps = [];
  let currentPage = 1;
  let activePlatform = '';

  const catLabels = {productivity:'Productivity',developer:'Dev Tools',design:'Design',writing:'Writing',utility:'Utilities',media:'Media',communication:'Communication',security:'Security',other:'Other'};
  const priceLabels = {free:'Free',freemium:'Freemium','open-source':'Open Source'};
  const pf = {mac:'fa-brands fa-apple',windows:'fa-brands fa-windows',linux:'fa-brands fa-linux',ios:'fa-brands fa-app-store-ios',android:'fa-brands fa-android',web:'fa-solid fa-globe'};

  function cardHTML(a) {
    const pIcon = a.price === 'free' ? '<i class="fa-regular fa-face-smile"></i> ' : a.price === 'open-source' ? '<i class="fa-solid fa-code"></i> ' : '';
    return `<a href="/software/${a.slug}/" class="scard" data-platforms="${a.platforms.join(',')}">
      <div class="scard-icon"><span class="scard-fallback">${a.name.charAt(0)}</span></div>
      <div class="scard-body">
        <div class="scard-top"><h3>${a.name}</h3>${a.featured ? '<span class="scard-flag">Hot</span>' : ''}</div>
        <p class="scard-desc">${a.tagline}</p>
        <div class="scard-meta">
          ${a.platforms.map(p => `<span class="badge badge-platform"><i class="${pf[p]}"></i></span>`).join('')}
          <span class="badge badge-price">${pIcon}${priceLabels[a.price]}</span>
          <span class="badge badge-category">${catLabels[a.category] || a.category}</span>
        </div>
      </div>
    </a>`;
  }

  function render() {
    const start = (currentPage - 1) * PER_PAGE;
    const page = filteredApps.slice(start, start + PER_PAGE);
    document.getElementById('app-grid')!.innerHTML = page.map(cardHTML).join('');
    document.getElementById('filter-count')!.textContent = String(filteredApps.length);
    updatePagination();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updatePagination() {
    const total = Math.ceil(filteredApps.length / PER_PAGE);
    const pag = document.getElementById('pagination')!;
    if (total <= 1) { pag.innerHTML = ''; return; }
    let h = `<button class="page-btn" data-p="prev" ${currentPage===1?'disabled':''}>← Prev</button>`;
    const s = Math.max(1, currentPage - 3), e = Math.min(total, s + 6);
    for (let i = s; i <= e; i++) h += `<button class="page-btn${i===currentPage?' active':''}" data-p="${i}">${i}</button>`;
    h += `<button class="page-btn" data-p="next" ${currentPage===total?'disabled':''}>Next →</button>`;
    pag.innerHTML = h;
    pag.querySelectorAll('button').forEach(b => {
      b.addEventListener('click', () => {
        const p = b.dataset.p!;
        if (p === 'prev') currentPage = Math.max(1, currentPage - 1);
        else if (p === 'next') currentPage = Math.min(total, currentPage + 1);
        else currentPage = parseInt(p);
        render();
      });
    });
  }

  function applyFilters() {
    filteredApps = activePlatform ? allApps.filter(a => a.platforms.includes(activePlatform)) : [...allApps];
    currentPage = 1;
    render();
  }

  // Load index
  fetch('/search-index').then(r => r.json()).then(data => {
    allApps = data;
    filteredApps = [...allApps];
    updatePagination();
  });

  // Platform filter
  document.querySelectorAll('.filter-group[data-group="platform"] .filter-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-group[data-group="platform"] .filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activePlatform = (btn as HTMLElement).dataset.value || '';
      applyFilters();
    });
  });

  // Sort
  document.querySelectorAll('.filter-group[data-group="sort"] .filter-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-group[data-group="sort"] .filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const sort = (btn as HTMLElement).dataset.value;
      if (sort === 'name') filteredApps.sort((a,b) => a.name.localeCompare(b.name));
      else filteredApps.sort((a,b) => (b.featured?1:0) - (a.featured?1:0));
      currentPage = 1;
      render();
    });
  });
</script>

<style>
  .pagination{display:flex;justify-content:center;gap:4px;margin-top:var(--gap-xl)}
  .page-btn{padding:8px 14px;border-radius:8px;font-size:.82rem;font-weight:500;border:1px solid var(--border);background:var(--surface);color:var(--text);cursor:pointer;transition:all .15s;font-family:inherit}
  .page-btn:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
  .page-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
  .page-btn:disabled{opacity:.3;cursor:default}
</style>
