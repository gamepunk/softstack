---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

export async function getStaticPaths() {
  const entries = await getCollection('software', ({ data }) => !data.draft && data.type === 'gui');
  return entries.map(e => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const all = await getCollection('software', ({ data }) => !data.draft && data.type === 'gui');
const entry = all.find(e => e.id === slug);
if (!entry) return Astro.redirect('/404');

const { data, body } = entry;
const rendered = await render(entry);
const hasBody = (body || '').trim().length > 0;

const priceLabels: Record<string, string> = { free:'Free', freemium:'Freemium', 'open-source':'Open Source' };
const priceFA: Record<string, string> = { free: 'fa-regular fa-face-smile', 'open-source': 'fa-solid fa-code' };
const platformNames: Record<string, string> = { mac:'macOS', windows:'Windows', linux:'Linux', ios:'iOS', android:'Android', web:'Web' };
const platformFA: Record<string, string> = { mac: 'fa-brands fa-apple', windows: 'fa-brands fa-windows', linux: 'fa-brands fa-linux', ios: 'fa-brands fa-app-store-ios', android: 'fa-brands fa-android', web: 'fa-solid fa-globe' };
const categoryNames: Record<string, string> = { productivity:'Productivity', developer:'Dev Tools', design:'Design', writing:'Writing', utility:'Utilities', media:'Media', communication:'Communication', security:'Security', other:'Other' };

const install = data.install;
const homebrewCmd = install?.homebrew;
const wingetCmd = install?.winget;
const title = `${data.name} — SoftStack`;

// Find articles referencing this app
const appSlug = slug;
const relatedArticles = allArticles
  .filter(a => a.body?.includes(`<!-- app:${appSlug} -->`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<Layout {title} description={data.tagline}>
  <div class="dp-breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href={`/categories/${data.category}/`}>{categoryNames[data.category]}</a> <span>/</span>
    <span>{data.name}</span>
  </div>

  <div class="dp-hero">
    <div class="dp-icon">
      {data.logo ? <img src={data.logo} alt="" /> : <span>{data.name.charAt(0)}</span>}
    </div>
    <div>
      <h1 class="dp-title">
        {data.name}
        {data.version && <span class="dp-ver">v{data.version}</span>}
      </h1>
      <p class="dp-tagline">{data.tagline}</p>
      <div class="dp-tags">
        {data.platforms.map(p => <span class="dp-tag"><i class={platformFA[p]}></i>{platformNames[p]}</span>)}
        <span class="dp-tag dp-tag-price">{priceFA[data.price] && <i class={priceFA[data.price]}></i>}{priceLabels[data.price]}</span>
        <span class="dp-tag dp-tag-cat">{categoryNames[data.category]}</span>
      </div>
    </div>
  </div>

  <div class="dp-grid">
    <div class="dp-main">
      <div class="dp-content">
        {hasBody ? <rendered.Content /> : <p>{data.description}</p>}
      </div>
      {data.screenshots.length > 0 && (
        <div class="dp-shots">
          {data.screenshots.map(s => <img src={s} alt="" loading="lazy" />)}
        </div>
      )}
    </div>

    <aside class="dp-side">
      <div class="dp-card">
        <a href={data.website} target="_blank" rel="noopener" class="dp-cta">Visit Website ↗</a>
        {data.download && <a href={data.download} target="_blank" rel="noopener" class="dp-cta dp-cta-sec">Direct Download</a>}
      </div>

      {(homebrewCmd || wingetCmd) && (
        <div class="dp-card">
          <h3 class="dp-card-title">Install</h3>
          {homebrewCmd && (
            <div class="dp-cmd">
              <span class="dp-cmd-label">brew</span>
              <code>{homebrewCmd}</code>
              <button class="dp-copy" onclick={`navigator.clipboard.writeText('${homebrewCmd.replace(/'/g, "\\'")}')`}>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="5" y="1" width="9" height="13" rx="1.5" stroke="currentColor"/><path d="M3 4H4V14H12V15H3.5C2.67 15 2 14.33 2 13.5V4.5C2 3.67 2.67 3 3.5 3H3V4Z" fill="currentColor"/></svg>
              </button>
            </div>
          )}
          {wingetCmd && (
            <div class="dp-cmd">
              <span class="dp-cmd-label">winget</span>
              <code>{wingetCmd}</code>
              <button class="dp-copy" onclick={`navigator.clipboard.writeText('${wingetCmd.replace(/'/g, "\\'")}')`}>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="5" y="1" width="9" height="13" rx="1.5" stroke="currentColor"/><path d="M3 4H4V14H12V15H3.5C2.67 15 2 14.33 2 13.5V4.5C2 3.67 2.67 3 3.5 3H3V4Z" fill="currentColor"/></svg>
              </button>
            </div>
          )}
        </div>
      )}

      <div class="dp-card">
        <h3 class="dp-card-title">Details</h3>
        <dl class="dp-dl">
          <dt>Category</dt><dd>{categoryNames[data.category]}</dd>
          <dt>Price</dt><dd>{priceLabels[data.price]}</dd>
          <dt>Platforms</dt><dd>{data.platforms.map(p => platformNames[p]).join(', ')}</dd>
          {data.version && <><dt>Version</dt><dd>{data.version}</dd></>}
          <dt>Website</dt><dd><a href={data.website} target="_blank" rel="noopener">{new URL(data.website).hostname}</a></dd>
          {install?.appstore && <><dt>App Store</dt><dd><a href={install.appstore} target="_blank" rel="noopener">Open ↗</a></dd></>}
          {install?.playstore && <><dt>Google Play</dt><dd><a href={install.playstore} target="_blank" rel="noopener">Open ↗</a></dd></>}
        </dl>
      </div>

      {relatedArticles.length > 0 && (
        <div class="dp-card">
          <h3 class="dp-card-title">Related Articles</h3>
          {relatedArticles.map(a => (
            <a href={`/articles/${a.id}/`} class="dp-article-link">
              <span class="dp-article-date">{a.data.date.toLocaleDateString('en-US', {month:'short', day:'numeric'})}</span>
              {a.data.title}
            </a>
          ))}
        </div>
      )}
    </aside>
  </div>
</Layout>

<style>
  .dp-breadcrumb{font-size:.8125rem;color:var(--text-tertiary);margin-bottom:var(--gap-lg)}
  .dp-breadcrumb a{color:var(--text-tertiary)}
  .dp-breadcrumb a:hover{color:var(--text)}
  .dp-breadcrumb span{margin:0 6px;opacity:.4}
  .dp-hero{display:flex;gap:var(--gap-lg);align-items:flex-start;margin-bottom:var(--gap-xl);padding:var(--gap-xl) 0;border-bottom:1px solid var(--border)}
  .dp-icon{width:80px;height:80px;border-radius:var(--radius-lg);background:var(--accent-subtle);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:2rem;font-weight:700;color:var(--accent);overflow:hidden}
  .dp-icon img{width:100%;height:100%;object-fit:cover}
  .dp-title{font-size:2rem;font-weight:700;letter-spacing:-.02em;margin-bottom:8px}
  .dp-ver{font-size:.4em;font-weight:500;background:var(--bg);padding:4px 12px;border-radius:99px;vertical-align:middle;margin-left:12px;color:var(--text-tertiary);border:1px solid var(--border)}
  .dp-tagline{font-size:1rem;color:var(--text-secondary);line-height:1.6;max-width:560px;margin-bottom:var(--gap-sm)}
  .dp-tags{display:flex;gap:8px;flex-wrap:wrap}
  .dp-tag{font-size:.75rem;font-weight:500;padding:4px 12px;border-radius:var(--radius);background:var(--bg);color:var(--text-secondary);display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border)}
  .dp-tag i{font-size:.75rem}
  .dp-tag-price{background:var(--accent-subtle);color:var(--accent);border-color:var(--accent-subtle)}
  .dp-tag-cat{background:var(--accent);color:#fff;border-color:var(--accent)}
  .dp-grid{display:grid;grid-template-columns:1fr 300px;gap:var(--gap-xl);align-items:start;padding-top:var(--gap-xl)}
  .dp-main{min-width:0}
  .dp-content{font-size:1rem;line-height:1.8;color:var(--text-secondary)}
  .dp-content p{white-space:pre-line;margin-bottom:var(--gap)}
  .dp-content :global(h2){font-size:1.125rem;color:var(--text);margin:var(--gap-xl) 0 var(--gap-sm);font-weight:600}
  .dp-content :global(h3){font-size:1rem;color:var(--text);margin:var(--gap-lg) 0 var(--gap-sm)}
  .dp-content :global(ul),.dp-content :global(ol){margin:var(--gap) 0;padding-left:1.3rem}
  .dp-content :global(li){margin-bottom:6px}
  .dp-content :global(code){font-size:.85em;background:var(--bg);padding:2px 6px;border-radius:4px;font-family:"SF Mono",SFMono-Regular,Menlo,Monaco,monospace;border:1px solid var(--border)}
  .dp-content :global(pre){background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:var(--gap);overflow-x:auto;margin:var(--gap) 0;font-size:.875rem;line-height:1.6}
  .dp-content :global(pre code){background:none;padding:0;border:none}
  .dp-content :global(table){width:100%;border-collapse:collapse;margin:var(--gap) 0;font-size:.9rem}
  .dp-content :global(th),.dp-content :global(td){text-align:left;padding:10px 14px;border-bottom:1px solid var(--border)}
  .dp-content :global(th){font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-tertiary)}
  .dp-content :global(blockquote){border-left:3px solid var(--accent);padding-left:var(--gap);margin:var(--gap) 0;font-style:italic;color:var(--text-tertiary)}
  .dp-content :global(a){color:var(--accent)}
  .dp-shots{display:flex;gap:var(--gap);overflow-x:auto;padding:var(--gap-lg) 0;margin-top:var(--gap-lg);border-top:1px solid var(--border)}
  .dp-shots img{border-radius:var(--radius-lg);border:1px solid var(--border);max-height:300px;width:auto;flex-shrink:0}
  .dp-side{position:sticky;top:72px;display:flex;flex-direction:column;gap:var(--gap)}
  .dp-card{background:var(--surface);border-radius:var(--radius-lg);padding:var(--gap-lg);border:1px solid var(--border)}
  .dp-card-title{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-tertiary);margin-bottom:var(--gap-sm)}
  .dp-cta{display:block;text-align:center;background:var(--accent);color:#fff;padding:12px 20px;border-radius:var(--radius);font-weight:600;font-size:.9rem;transition:all .2s;margin-bottom:var(--gap-sm)}
  .dp-cta:last-child{margin-bottom:0}
  .dp-cta:hover{color:#fff;background:var(--accent-hover);transform:translateY(-1px)}
  .dp-cta-sec{background:transparent;color:var(--accent);box-shadow:inset 0 0 0 1.5px var(--accent)}
  .dp-cta-sec:hover{background:var(--accent-subtle);color:var(--accent-hover)}
  .dp-cmd{display:flex;align-items:center;gap:var(--gap-sm);padding:10px 0;border-bottom:1px solid var(--border)}
  .dp-cmd:last-child{border-bottom:none}
  .dp-cmd-label{font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text-tertiary);min-width:50px}
  .dp-cmd code{flex:1;font-size:.8125rem;font-family:"SF Mono",SFMono-Regular,Menlo,Monaco,monospace;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:var(--bg);padding:4px 8px;border-radius:4px;border:1px solid var(--border)}
  .dp-copy{display:flex;align-items:center;justify-content:center;background:none;border:none;color:var(--text-tertiary);cursor:pointer;padding:4px;border-radius:4px;flex-shrink:0}
  .dp-copy:hover{background:var(--accent-subtle);color:var(--accent)}
  .dp-dl{display:grid;grid-template-columns:auto 1fr;gap:8px var(--gap);font-size:.875rem}
  .dp-dl dt{color:var(--text-tertiary);font-weight:500}
  .dp-dl dd{color:var(--text);font-weight:500}
  .dp-dl a{color:var(--accent)}
  .dp-article-link{display:block;padding:8px 0;font-size:.875rem;color:var(--text);text-decoration:none;border-bottom:1px solid var(--border);line-height:1.5}
  .dp-article-link:last-child{border-bottom:none;padding-bottom:0}
  .dp-article-link:hover{color:var(--accent)}
  .dp-article-date{display:block;font-size:.6875rem;color:var(--text-tertiary);margin-bottom:2px}
  @media(max-width:900px){
    .dp-grid{grid-template-columns:1fr}
    .dp-side{position:static;order:-1}
    .dp-hero{flex-direction:column}
    .dp-icon{width:64px;height:64px;font-size:1.5rem}
    .dp-title{font-size:1.5rem}
  }
</style>
