---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <div style="text-align:center;padding:var(--gap-xl) 0">
    <h1 style="font-size:5rem;font-weight:800;margin-bottom:var(--gap-sm);line-height:1">404</h1>
    <p style="font-size:1.1rem;margin-bottom:var(--gap-lg)">Page not found.</p>
    <a href="/" style="display:inline-block;background:var(--accent);color:#fff;padding:10px 24px;border-radius:99px;font-weight:600;font-size:.9rem">Back to Home</a>
  </div>
</Layout>
