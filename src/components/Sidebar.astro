---
import { getCollection } from 'astro:content';

interface Props {
  activeCategory?: string;
  activeAll?: boolean;
}
const { activeCategory, activeAll } = Astro.props;

const categoryNames: Record<string, string> = {
  productivity:'Productivity', developer:'Developer Tools', design:'Design', writing:'Writing',
  utility:'Utilities', media:'Media', communication:'Communication', security:'Security', other:'Other'
};
const categoryIcons: Record<string, string> = {
  productivity:'fa-solid fa-bolt', developer:'fa-solid fa-code', design:'fa-solid fa-palette', writing:'fa-solid fa-pen',
  utility:'fa-solid fa-toolbox', media:'fa-solid fa-play', communication:'fa-solid fa-comment', security:'fa-solid fa-shield', other:'fa-solid fa-ellipsis'
};
const platformNames: Record<string, string> = { mac:'macOS', windows:'Windows', linux:'Linux', ios:'iOS', android:'Android', web:'Web' };
const platformIcons: Record<string, string> = { mac:'fa-brands fa-apple', windows:'fa-brands fa-windows', linux:'fa-brands fa-linux', ios:'fa-brands fa-app-store-ios', android:'fa-brands fa-android', web:'fa-solid fa-globe' };

const all = (await getCollection('software')).filter(p => !p.data.draft && p.data.type === 'gui');
const categories = [...new Set(all.map(p => p.data.category))].sort();
const countByCat = (cat: string) => all.filter(p => p.data.category === cat).length;
const platforms = ['mac', 'windows', 'linux', 'ios', 'android', 'web'] as const;
const countByPlatform = (p: string) => all.filter(s => s.data.platforms.includes(p as any)).length;
---

<aside class="sidebar">
  <nav class="sidebar-nav">
    <a href="/software/" class={`sidebar-link${activeAll ? ' active' : ''}`}>
      <i class="fa-solid fa-layer-group"></i>
      All Apps
      <span class="sidebar-count">{all.length}</span>
    </a>
    <a href="/articles/" class="sidebar-link">
      <i class="fa-solid fa-newspaper"></i>
      Articles
    </a>

    <div class="sidebar-divider"></div>
    <div class="sidebar-title">Categories</div>
    {categories.map(c => (
      <a href={`/categories/${c}/`} class={`sidebar-link${activeCategory === c ? ' active' : ''}`}>
        <i class={categoryIcons[c]}></i>
        {categoryNames[c]}
        <span class="sidebar-count">{countByCat(c)}</span>
      </a>
    ))}

    <div class="sidebar-divider"></div>
    <div class="sidebar-title">Platforms</div>
    {platforms.map(p => (
      <a href={`/software/?platform=${p}`} class="sidebar-link">
        <i class={platformIcons[p]}></i>
        {platformNames[p]}
        <span class="sidebar-count">{countByPlatform(p)}</span>
      </a>
    ))}
  </nav>
</aside>